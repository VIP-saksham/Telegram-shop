# .env.example
# SECURITY WARNING: Never commit real credentials to version control!
# Copy this file to .env and fill with actual values

# === TELEGRAM CONFIGURATION ===
# Get from @BotFather
TOKEN=your_bot_token_here
# Your Telegram user ID (get from @userinfobot)
OWNER_ID=123456789

# === PAYMENT CONFIGURATION ===
# Telegram Payments provider token (optional)
TELEGRAM_PROVIDER_TOKEN=

# CryptoPay API token (optional)
CRYPTO_PAY_TOKEN=

# Telegram Stars configuration
# Price of 1 unit of your currency in stars (0 to disable)
STARS_PER_VALUE=0.91

# Currency for payments (3-letter code: RUB, USD, EUR, etc.)
PAY_CURRENCY=RUB

# Referral system percentage (0-100, 0 to disable)
REFERRAL_PERCENT=0

# Payment timeout in seconds
PAYMENT_TIME=1800

# Payment limits
MIN_AMOUNT=20
MAX_AMOUNT=10000

# === LINKS & UI CONFIGURATION ===
# Telegram channel for notifications (optional)
# Format: @channelname or https://t.me/channelname
CHANNEL_URL=

# Telegram channel ID
CHANNEL_ID=

# Support user ID (optional)
HELPER_ID=

# Bot rules text (optional)
RULES="1. Be respectful\n2. No spam\n3. Follow Telegram ToS"

# === LOCALIZATION & LOGGING ===
# Bot language (ru or en)
BOT_LOCALE=ru

# Log files paths
BOT_LOGFILE=logs/bot.log
BOT_AUDITFILE=logs/audit.log

# Logging configuration (1 to enable, 0 to disable)
LOG_TO_STDOUT=1
LOG_TO_FILE=1
DEBUG=0

# Enable/disable the review system (1 = enabled, 0 = disabled)
REVIEWS_ENABLED=1

# === TELEGRAM LOG GROUP ===
# Chat/group ID where every audited action is mirrored (purchases, top-ups,
# admin actions, errors). The bot must be a member of that group.
# Leave empty to disable. Get the ID by adding the bot to the group and
# forwarding a message to @getidsbot
LOG_GROUP_ID=
# Which event classes go to the group, comma-separated:
# all, payments, purchases, admin, security, errors (or "off" to disable)
LOG_GROUP_EVENTS=all
# Optional dedicated money room: payments + purchases are mirrored here instead
# of LOG_GROUP_ID (falls back to LOG_GROUP_ID when empty).
PAYMENT_LOG_GROUP_ID=

# === SUDO USERS ===
# Comma-separated Telegram IDs that receive the built-in SUDO role on /start
# (full admin control, above ADMIN, below OWNER; protected from other admins).
SUDO_IDS=

# === REDIS CONFIGURATION ===
# Set to 0 to disable Redis entirely (bot will use in-memory storage)
REDIS_ENABLED=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis password. Must stay non-empty when using the bundled Docker Redis service.
REDIS_PASSWORD=changeme_redis_pass

# === DATABASE CONFIGURATION ===
POSTGRES_DB=telegram_shop
POSTGRES_USER=shop_user
# SECURITY: Use strong password! Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# === WEB ADMIN PANEL ===
ADMIN_HOST=localhost
ADMIN_PORT=9090
ADMIN_USERNAME=admin
# SECURITY: the bot REFUSES TO START with these two left at their defaults when the
# panel is reachable. SECRET_KEY signs the admin session cookie.
ADMIN_PASSWORD=admin
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ADMIN_COOKIE_SECURE=auto

# === WEBHOOK MODE (optional) ===
WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# === AUTO-CLEANUP ===
AUDIT_RETENTION_DAYS=90
PAYMENTS_RETENTION_DAYS=90
